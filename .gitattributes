# 默认：自动检测文本文件，提交时统一为 LF（作用：防止 Windows / Mac / Linux 换行符不一致的问题）
* text=auto eol=lf

# 明确指定为文本的文件
*.md text eol=lf
*.txt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.properties text eol=lf

# 明确指定为二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary